{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": false,
  "singleQuote": true,
  "printWidth": 120,
  "trailingComma": "none",
  "quoteProps": "preserve",
  "bracketSpacing": true,
  "jsxSingleQuote": false,
  "useTabs": false,
  "tabWidth": 2,
  "proseWrap": "preserve",
  "arrowParens": "always",
  "sortPackageJson": false,
  "ignorePatterns": [
    "./site/public/**"
  ]
}
