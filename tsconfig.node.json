{
  "extends": "@tsconfig/node22/tsconfig.json",
  "include": [
    "./tsdown.config.ts",
    "./vitest.config.ts",
    "./dev-server/vite.config.ts",
    "./dev-server/vite-plugins/vite-plugin-uno-preset.js",
    "./internals/unplugin-virtual-template/**/*.ts",
    "./internals/vite-svg-loader/**/*.ts"
  ],
  "exclude": ["./internals/unplugin-virtual-template/client.d.ts", "./internals/vite-svg-loader/client.d.ts"],
  "compilerOptions": {
    "module": "preserve",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "types": ["node"],
    "noEmit": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo"
  }
}
