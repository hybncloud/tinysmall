{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "compilerOptions": {
    "allowJs": true,
    "noImplicitAny": false,
    "paths": {
      "@hybncloud/tinysmall": ["./src/index.ts"],
      "@tinysmall/utils": ["./src/utils"],
      "@tinysmall/icon": ["./icons"],
      "@tinysmall/common": ["./src/common"],
      "@tinysmall/directive": ["./src/directives"],
      "@tinysmall/hooks": ["./src/hooks"],
      "@tinysmall/locale": ["./locale/src"],
      "@tinysmall/renderless/types": ["./src/renderless/types"],
      "@tinysmall/renderless/types/*": ["./src/renderless/types/*"],
      "@tinysmall/renderless/*": ["./src/renderless/src/*"],
      "@tinysmall/theme/*": ["./theme/src/*"],
      "@tinysmall/*": ["./src/components/*"],
      "virtual:common/adapter/vue": ["./src/common/adapter/vue3/index.ts"],
      "virtual:locale/vue": ["./locale/src/vue3/index.ts"],
      "package.json": ["./package.json"],
      "@tinysmall-internal/vue-test-utils": ["./internals/vue-test-utils/src"]
    },
    "types": [
      "node",
      "vite/client",
      "./internals/unplugin-virtual-template/client",
      "./internals/vite-svg-loader/client",
      "./env"
    ],
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.vue.tsbuildinfo"
  },
  "include": [
    "./src/**/*.ts",
    "./src/**/*.tsx",
    "./src/**/*.vue",
    "./icons/index.ts",
    "./icons/src/**/*.ts",
    "./locale/src/**/*.ts",
    "./theme/src/**/*.ts",
    "./dev-server/src/**/*.js",
    "./dev-server/src/**/*.ts",
    "./dev-server/src/**/*.tsx",
    "./dev-server/src/**/*.vue"
  ]
}
