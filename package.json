{
  "name": "tinysmall",
  "version": "3.32.0",
  "description": "An enterprise-class UI component library.",
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "keywords": [
    "vue",
    "vue3",
    "frontend",
    "component-library",
    "components",
    "vue-components",
    "opentiny",
    "renderless-components",
    "headless-components"
  ],
  "author": "TinySmall Team",
  "license": "MIT",
  "scripts": {
    "dev": "vite dev-server",
    "build": "run-p type-check \"build-only {@}\" --",
    "build-only": "tsdown",
    "type-check": "vue-tsc --build",
    "site:dev": "pnpm -C site dev",
    "site:build": "pnpm -C site build",
    "site:build-only": "pnpm -C site build-only",
    "site:type-check": "pnpm -C site type-check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "test:e2e": "playwright test"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^12.16.1",
      "onFail": "download"
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@rollup/pluginutils": "^5.5.1",
    "@tsconfig/node22": "^22.0.6",
    "@tsdown/css": "^0.23.5",
    "@types/gradient-parser": "^1.1.0",
    "@types/node": "^22.20.5",
    "@unocss/reset": "^66.12.0",
    "@vitest/coverage-v8": "5.0.5",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "jsdom": "^30.1.3",
    "less": "^4.9.1",
    "magic-string": "^1.4.5",
    "npm-run-all2": "^9.0.4",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "resize-observer-polyfill": "^1.5.1",
    "svgo": "^4.1.0",
    "tsdown": "^0.23.5",
    "typescript": "^6.0.3",
    "unocss": "^66.12.0",
    "unplugin": "^3.7.0",
    "unplugin-vue": "^8.0.1",
    "unplugin-vue-jsx": "^0.10.0",
    "unplugin-vue-markdown": "^32.1.1",
    "unrun": "^0.3.1",
    "vite": "^8.3.5",
    "vite-plugin-dynamic-import": "^1.6.0",
    "vitest": "^5.0.5",
    "vue-i18n": "^11.4.16",
    "vue-tsc": "^3.3.13"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.6.9",
    "gradient-parser": "^1.1.0",
    "qrcode": "1.5.1",
    "shepherd.js": "11.0.1",
    "streamsaver": "2.0.6",
    "xss": "1.0.14"
  },
  "peerDependencies": {
    "vue": "^3.5.44"
  }
}
